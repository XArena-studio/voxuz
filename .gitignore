# ── Python ──────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
ENV/
.venv/
.env/

# ── Environment variables ────────
.env
.env.local
.env.*.local
*.env

# ── FastAPI / Uvicorn ────────────
*.log

# ── Audio & Model files ──────────
backend/voices/
backend/outputs/
backend/temp/
*.wav
*.mp3
*.ogg
*.webm
*.flac
*.m4a
*.npy

# ── XTTS / Whisper cache ─────────
tts_models/
whisper_models/
~/.cache/huggingface/
~/.local/share/tts/

# ── Database ─────────────────────
*.db
*.sqlite
*.sqlite3

# ── Docker ───────────────────────
docker-compose.override.yml

# ── Next.js ──────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/
frontend/.npm
frontend/.eslintcache

